# Copy to .env for local development:  cp .env.example .env
# .env is git-ignored. Real environment variables always override these.
# All keys are prefixed VORTEX_ and map to fields on vortex_ai_gateway.config.Settings.

# local | dev | staging | prod
VORTEX_ENVIRONMENT=local

# Standard Python logging level name.
VORTEX_LOG_LEVEL=INFO

# Redis instance backing rate limiting and load balancing.
VORTEX_REDIS_URL=redis://localhost:6379/0

# How long to wait for a provider's answer (seconds). Long: generation is slow.
VORTEX_REQUEST_TIMEOUT_SECONDS=30

# How long to wait for the connection itself (seconds). Short: a host that has
# not completed a handshake in a few seconds is unreachable, not busy. Sharing
# one budget with the read timeout means an unroutable IP pins a worker for the
# full 30s — measured in docs/notes/day-04.md.
VORTEX_CONNECT_TIMEOUT_SECONDS=5

# Client API keys accepted at the edge, comma-separated. Leave empty in local
# development to accept any well-formed `Authorization: Bearer <key>` header;
# a request with no key is rejected either way.
VORTEX_API_KEYS=

# --- Provider routing -------------------------------------------------------
# Which provider serves which model, as an ordered list of `pattern=provider`
# rules. First match wins, so a specific rule may precede a general one, and
# patterns are shell globs. For example:
#
#   VORTEX_MODEL_ROUTES=gpt-4o=openai,gpt-*=openai,claude-*=anthropic,local/*=ollama
#
# Left empty — as it is here — the gateway serves canned replies from its mock
# provider, which is what makes `cp .env.example .env` work with no keys.
VORTEX_MODEL_ROUTES=

# Where a model matching no rule goes. Empty means "reject it with a 404",
# which keeps a typo'd model name from quietly billing whoever is listed first.
VORTEX_DEFAULT_PROVIDER=

# Credentials for the providers the table names. A provider that is routed to
# without its key stops the gateway at startup rather than on first request.
# Base URLs are optional: empty means the vendor's own endpoint, so set one
# only for a self-hosted, proxied or emulated deployment.
VORTEX_OPENAI_API_KEY=
VORTEX_OPENAI_BASE_URL=
VORTEX_ANTHROPIC_API_KEY=
VORTEX_ANTHROPIC_BASE_URL=
VORTEX_OLLAMA_API_KEY=
VORTEX_OLLAMA_BASE_URL=http://localhost:11434

# --- Client keys ------------------------------------------------------------
# SQLite file holding hashed, revocable keys, minted by the `vortex-keys` CLI
# (ADR-003). Set, it becomes the *only* accepted source of keys and
# VORTEX_API_KEYS above is ignored — two allow-lists means revoking from one and
# still being let in by the other. Leave empty for local development.
#
#   vortex-keys create --name ci-pipeline --rpm 600 --tpm 150000
#   vortex-keys list
#   vortex-keys revoke 9f2c41ab77de
VORTEX_KEY_DB_PATH=

# --- Rate limiting and usage accounting -------------------------------------
# Turns on the Redis-backed limiter and the usage ledger together. Off by
# default because both need Redis, and a laptop should not (ADR-021, ADR-022).
VORTEX_METERING_ENABLED=false

# Per-key limits for keys that do not carry their own. Zero is unlimited, and
# unlimited keys never touch Redis at all.
VORTEX_RATE_LIMIT_DEFAULT_RPM=0
VORTEX_RATE_LIMIT_DEFAULT_TPM=0

# What a request is assumed to cost when the caller sets no max_completion_tokens.
# Reserved on admission and reconciled against real usage on settlement, so this
# governs how much a caller may have in flight, not what they are charged.
VORTEX_RATE_LIMIT_ASSUMED_COMPLETION_TOKENS=512

# JSON overriding the built-in price table, in USD per million tokens:
#   {"gpt-4o": {"prompt": 2.5, "completion": 10.0}}
# Consulted before the built-ins, so it need only name what it corrects. A file
# that cannot be read stops the gateway rather than reverting to defaults.
VORTEX_PRICE_TABLE_PATH=

# How long per-key token counters live, and so how far back GET /v1/usage sees.
VORTEX_USAGE_RETENTION_DAYS=30

# --- Response cache ---------------------------------------------------------
# Exact request→response caching in Redis (ADR-004). Its own switch, separate
# from metering: a cache changes what callers *see* — the same answer twice —
# where the limiter only changes what they may send. Shares the connection above.
VORTEX_CACHE_ENABLED=false

# Default entry lifetime in seconds, and so the longest a caller can be served
# a sample that is no longer fresh.
VORTEX_CACHE_TTL_SECONDS=300

# Per-route overrides as `path=seconds`, comma-separated. Zero is a rule, not an
# absence: it means "never cache this route".
#   /v1/chat/completions=600
VORTEX_CACHE_TTLS=

# Who shares an entry: `key` gives every API key its own namespace, `global`
# shares one across the gateway. `global` is safe only where every caller is the
# same tenant — an exact hit returns a completion generated under another key.
VORTEX_CACHE_SCOPE=key

# Semantic tier behind the exact cache (ADR-024): consulted only on an exact
# miss, needs an embedder passed to `create_app(embedder=...)`. Off by default
# because ADR-005 found no threshold that admits paraphrases without admitting
# one-token near misses, for either embedder measured. Run
# `scripts/threshold_experiment.py` before trusting a value here with a new
# model; every miss logs the nearest score in `X-Semantic-Cache-Score`.
VORTEX_SEMANTIC_CACHE_ENABLED=false
VORTEX_SEMANTIC_CACHE_THRESHOLD=0.95

# Which model embeds, as an Ollama model name (ADR-025). This is the whole
# switch: empty means no embedder, and the tier warns and stays off. No
# default, because a threshold measured for one model is a prior for the next.
# The server falls back to VORTEX_OLLAMA_BASE_URL, then to Ollama's default.
#   nomic-embed-text
VORTEX_EMBEDDING_MODEL=
VORTEX_EMBEDDING_BASE_URL=

# Debugging: send `X-Vortex-Cache-Bypass: true` on a request to skip the lookup
# and the store, so an answer the cache cannot have touched comes back and the
# entry that was there is left alone.

# --- Observability ----------------------------------------------------------
# What this process calls itself in traces and in `vortex_build_info`.
VORTEX_SERVICE_NAME=vortex-ai-gateway

# OpenTelemetry tracing (ADR-026): one trace per request, with a child span per
# cache tier, per provider call and per retry attempt. Off by default, and off
# costs nothing — with no SDK installed the OTel API hands back a no-op tracer,
# so the instrumentation stays in the code path and does nothing.
VORTEX_TRACING_ENABLED=false

# `otlp` speaks OTLP over HTTP to a collector; `console` prints spans as JSON,
# which is how to see what is being produced without standing up a collector.
VORTEX_TRACING_EXPORTER=otlp

# The collector's trace endpoint. Empty defers to the SDK's own
# OTEL_EXPORTER_OTLP_* variables, so an already-instrumented host needs nothing
# here. `compose.yaml --profile tracing` runs Jaeger at:
#   http://localhost:4318/v1/traces
VORTEX_TRACING_ENDPOINT=

# Share of traces kept, 0 to 1. Applied only to traces that start here: a
# request arriving with a sampled parent is always kept, or the trace has a
# hole in it exactly where the gateway is.
VORTEX_TRACING_SAMPLE_RATIO=1.0

# The Prometheus scrape endpoint. On by default, unlike everything else here,
# because it needs nothing — no Redis, no collector, no credentials. It is
# served *open*, beside the health probes, because a scraper has no API key
# (ADR-028); a gateway exposed directly to the internet should set this false
# and scrape a sidecar instead.
VORTEX_METRICS_ENABLED=true
VORTEX_METRICS_PATH=/metrics

# How many distinct values the `model` label may take before the rest report as
# `other`. A label a caller picks is a time series a caller allocates, and this
# is the number that bounds it (ADR-027). Seeing `other` on a dashboard is the
# signal to raise it.
VORTEX_METRICS_LABEL_BUDGET=50

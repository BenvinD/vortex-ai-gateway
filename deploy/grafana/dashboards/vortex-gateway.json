          "expr": "sum by (error) (rate(vortex_provider_retries_total[$__rate_interval]))",
          "legendFormat": "retry: {{error}}",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "vortex-prometheus"
          },
          "editorMode": "code",
          "expr": "sum by (reason) (rate(vortex_provider_give_ups_total[$__rate_interval]))",
          "legendFormat": "gave up: {{reason}}",
          "range": true,
          "refId": "B"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []

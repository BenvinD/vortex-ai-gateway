{
  "annotations": {
    "list": []
  },
  "editable": false,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Requests / sec",
      "description": "Everything the gateway served, health probes and scrapes included.",
      "datasource": {
        "type": "prometheus",
        "uid": "vortex-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "vortex-prometheus"
          },
          "editorMode": "code",
          "expr": "sum(rate(vortex_requests_total[$__rate_interval]))",
          "legendFormat": "",
          "range": true,
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 2,
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Error rate",
      "description": "5xx only. A 429 is the limiter working and a 404 is a caller typo; neither is this gateway failing.",
      "datasource": {
        "type": "prometheus",
        "uid": "vortex-prometheus"
      },
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "vortex-prometheus"
          },
          "editorMode": "code",
          "expr": "sum(rate(vortex_requests_total{status=~\"5..\"}[$__rate_interval])) / clamp_min(sum(rate(vortex_requests_total[$__rate_interval])), 0.0001)",
          "legendFormat": "",
          "range": true,
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.01
              },
              {
                "color": "red",
                "value": 0.05
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Exact cache hit rate",
      "description": "Hits over lookups. BYPASS is excluded from the denominator on purpose: the cache was never asked, so it cannot have missed.",
      "datasource": {
        "type": "prometheus",
        "uid": "vortex-prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "vortex-prometheus"
          },
          "editorMode": "code",
          "expr": "sum(rate(vortex_cache_lookups_total{tier=\"exact\",outcome=\"HIT\"}[$__rate_interval])) / clamp_min(sum(rate(vortex_cache_lookups_total{tier=\"exact\",outcome=~\"HIT|MISS\"}[$__rate_interval])), 0.0001)",
          "legendFormat": "",
          "range": true,
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      }
    },
